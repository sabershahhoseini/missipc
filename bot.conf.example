# Copy to bot.conf (or anywhere) and fill in, then:
#   python bot.py --config bot.conf
# Lines are KEY=VALUE, '#' starts a comment, values may be quoted.
# Anything set as a real environment variable overrides this file.

BOT_TOKEN=123456:ABC...
ALLOWED_USERS=11111111


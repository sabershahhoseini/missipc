# Copy to bot.yaml (or anywhere) and fill in, then:
#   python bot.py --config bot.yaml
# Top-level keys match the environment variable names in the README.
# Anything set as a real environment variable overrides this file.

BOT_TOKEN: "123456:ABC..."
ALLOWED_USERS: [11111111]


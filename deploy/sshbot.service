# Copy to /etc/systemd/system/sshbot.service, edit paths and env, then:
#   systemctl daemon-reload && systemctl enable --now sshbot
[Unit]
Description=Telegram SSH bot
After=network-online.target
Wants=network-online.target

[Service]
User=sshbot
WorkingDirectory=/opt/tgssh
Environment=BOT_TOKEN=123456:replace-me
Environment=ALLOWED_USERS=11111111
Environment=DATA_DIR=/opt/tgssh/data
# Environment=HEALTHCHECK_URL=https://hc-ping.com/your-uuid
ExecStart=/opt/tgssh/venv/bin/python bot.py
# Or put everything in one file and drop the Environment= lines above:
# ExecStart=/opt/tgssh/venv/bin/python bot.py --config /opt/tgssh/bot.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

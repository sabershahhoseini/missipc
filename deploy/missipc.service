# Copy to /etc/systemd/system/missipc.service, edit paths and env, then:
#   systemctl daemon-reload && systemctl enable --now missipc
[Unit]
Description=MissiPC
After=network-online.target
Wants=network-online.target

[Service]
User=missipc
WorkingDirectory=/opt/missipc
Environment=BOT_TOKEN=123456:replace-me
Environment=ALLOWED_USERS=11111111
Environment=DATA_DIR=/opt/missipc/data
# Environment=HEALTHCHECK_URL=https://hc-ping.com/your-uuid
ExecStart=/opt/missipc/venv/bin/python bot.py
# Or put everything in one file and drop the Environment= lines above:
# ExecStart=/opt/missipc/venv/bin/python bot.py --config /opt/missipc/bot.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
